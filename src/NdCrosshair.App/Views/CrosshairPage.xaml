<UserControl x:Class="NdCrosshair.App.Views.CrosshairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:NdCrosshair.App"
             xmlns:core="clr-namespace:NdCrosshair.Core;assembly=NdCrosshair.Core"
             xmlns:l="clr-namespace:NdCrosshair.App.Localization">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{l:T NavCrosshair}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{l:T CrosshairSubtitle}" Style="{StaticResource PageSubtitle}" />
                <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="DesignTab" Content="{Binding DesignTabShapeLabel}"
                                     IsChecked="{Binding DesignTab, Converter={StaticResource EnumMatch}, ConverterParameter=Shape}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="DesignTab" Content="{l:T TabColor}"
                                     IsChecked="{Binding DesignTab, Converter={StaticResource EnumMatch}, ConverterParameter=Color}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="DesignTab" Content="{l:T TabEffects}"
                                     IsChecked="{Binding DesignTab, Converter={StaticResource EnumMatch}, ConverterParameter=Effects}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="DesignTab" Content="{l:T TabLayer}"
                                     IsChecked="{Binding DesignTab, Converter={StaticResource EnumMatch}, ConverterParameter=Layer}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
                <Grid>
                    <StackPanel Visibility="{Binding DesignTab, Converter={StaticResource EnumVisibility}, ConverterParameter=Shape}">
                        <StackPanel Visibility="{Binding IsClassicLayer, Converter={StaticResource Visible}}">
                            <GroupBox Header="{l:T CardLines}">
                                <StackPanel>
                                    <app:SettingSlider Label="{l:T ArmCount}" Value="{Binding ArmCount}"
                                                       Minimum="{x:Static core:CrosshairSettings.MinArmCount}"
                                                       Maximum="{x:Static core:CrosshairSettings.MaxArmCount}" />
                                    <WrapPanel Margin="0,6,0,6" Visibility="{Binding IsFourArms, Converter={StaticResource Visible}}">
                                        <CheckBox Style="{StaticResource ChipCheckBox}" Content="{l:T LineTop}" IsChecked="{Binding ShowTop}" />
                                        <CheckBox Style="{StaticResource ChipCheckBox}" Content="{l:T LineBottom}" IsChecked="{Binding ShowBottom}" />
                                        <CheckBox Style="{StaticResource ChipCheckBox}" Content="{l:T LineLeft}" IsChecked="{Binding ShowLeft}" />
                                        <CheckBox Style="{StaticResource ChipCheckBox}" Content="{l:T LineRight}" IsChecked="{Binding ShowRight}" />
                                    </WrapPanel>
                                    <app:SettingSlider Label="{l:T Length}" Value="{Binding LineLength}"
                                                       Minimum="{x:Static core:CrosshairSettings.MinLineLength}"
                                                       Maximum="{x:Static core:CrosshairSettings.MaxLineLength}" />
                                    <app:SettingSlider Label="{l:T Thickness}" Value="{Binding LineThickness}"
                                                       Minimum="{x:Static core:CrosshairSettings.MinLineThickness}"
                                                       Maximum="{x:Static core:CrosshairSettings.MaxLineThickness}" />
                                    <app:SettingSlider Label="{l:T Gap}" Value="{Binding Gap}"
                                                       Minimum="{x:Static core:CrosshairSettings.MinGap}"
                                                       Maximum="{x:Static core:CrosshairSettings.MaxGap}" />
                                    <app:SettingSlider Label="{l:T Rotation}" Value="{Binding Rotation}"
                                                       Minimum="{x:Static core:CrosshairSettings.MinRotation}"
                                                       Maximum="{x:Static core:CrosshairSettings.MaxRotation}" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox>
                                <GroupBox.Header>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" Margin="0"
                                                  IsChecked="{Binding ShowDot}" AutomationProperties.Name="{l:T CardDot}" />
                                        <TextBlock Text="{l:T CardDot}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </GroupBox.Header>
                                <StackPanel IsEnabled="{Binding ShowDot}">
                                    <CheckBox Content="{l:T DotRound}" IsChecked="{Binding RoundDot}" />
                                    <app:SettingSlider Label="{l:T Size}" Value="{Binding DotSize}"
                                                       Minimum="{x:Static core:CrosshairSettings.MinDotSize}"
                                                       Maximum="{x:Static core:CrosshairSettings.MaxDotSize}" />
                                    <TextBlock Text="{l:T DotParityHint}" Style="{StaticResource WarningText}" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,6,0,0" Visibility="{Binding ShowParityHint, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Margin="0">
                                <GroupBox.Header>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" Margin="0"
                                                  IsChecked="{Binding ShowRing}" AutomationProperties.Name="{l:T CardRing}" />
                                        <TextBlock Text="{l:T CardRing}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </GroupBox.Header>
                                <StackPanel IsEnabled="{Binding ShowRing}">
                                    <app:SettingSlider Label="{l:T Radius}" Value="{Binding RingRadius}"
                                                       Minimum="{x:Static core:CrosshairSettings.MinRingRadius}"
                                                       Maximum="{x:Static core:CrosshairSettings.MaxRingRadius}" />
                                    <app:SettingSlider Label="{l:T Thickness}" Value="{Binding RingThickness}"
                                                       Minimum="{x:Static core:CrosshairSettings.MinRingThickness}"
                                                       Maximum="{x:Static core:CrosshairSettings.MaxRingThickness}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsShapeLayer, Converter={StaticResource Visible}}">
                            <GroupBox Header="{l:T CardShape}" Margin="0">
                                <StackPanel>
                                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="ShapeKind" Content="{l:T ShapeRectangle}"
                                                         IsChecked="{Binding ShapeKind, Converter={StaticResource EnumMatch}, ConverterParameter=Rectangle}" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="ShapeKind" Content="{l:T ShapeTriangle}"
                                                         IsChecked="{Binding ShapeKind, Converter={StaticResource EnumMatch}, ConverterParameter=Triangle}" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="ShapeKind" Content="{l:T ShapeChevron}"
                                                         IsChecked="{Binding ShapeKind, Converter={StaticResource EnumMatch}, ConverterParameter=Chevron}" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="ShapeKind" Content="{l:T ShapeArc}"
                                                         IsChecked="{Binding ShapeKind, Converter={StaticResource EnumMatch}, ConverterParameter=Arc}" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="ShapeKind" Content="{l:T ShapeTShape}"
                                                         IsChecked="{Binding ShapeKind, Converter={StaticResource EnumMatch}, ConverterParameter=TShape}" />
                                        </StackPanel>
                                    </Border>
                                    <CheckBox Content="{l:T ShapeFilled}" IsChecked="{Binding ShapeFilled}" Margin="0,12,0,4"
                                              Visibility="{Binding ShapeSupportsFill, Converter={StaticResource Visible}}" />
                                    <app:SettingSlider Label="{l:T ShapeWidth}" Value="{Binding ShapeWidth}" Margin="0,8,0,0"
                                                       Minimum="{x:Static core:ShapeLayer.MinSize}"
                                                       Maximum="{x:Static core:ShapeLayer.MaxSize}" />
                                    <app:SettingSlider Label="{l:T ShapeHeight}" Value="{Binding ShapeHeight}"
                                                       Minimum="{x:Static core:ShapeLayer.MinSize}"
                                                       Maximum="{x:Static core:ShapeLayer.MaxSize}"
                                                       Visibility="{Binding ShapeUsesHeight, Converter={StaticResource Visible}}" />
                                    <app:SettingSlider Label="{l:T Thickness}" Value="{Binding ShapeThickness}"
                                                       Minimum="{x:Static core:ShapeLayer.MinThickness}"
                                                       Maximum="{x:Static core:ShapeLayer.MaxThickness}"
                                                       IsEnabled="{Binding ShapeUsesThickness}" />
                                    <app:SettingSlider Label="{l:T ShapeSweep}" Value="{Binding ShapeSweep}"
                                                       Minimum="{x:Static core:ShapeLayer.MinSweep}"
                                                       Maximum="{x:Static core:ShapeLayer.MaxSweep}"
                                                       Visibility="{Binding IsArcShape, Converter={StaticResource Visible}}" />
                                    <app:SettingSlider Label="{l:T Rotation}" Value="{Binding ShapeRotation}"
                                                       Minimum="{x:Static core:CrosshairSettings.MinRotation}"
                                                       Maximum="{x:Static core:CrosshairSettings.MaxRotation}" />
                                    <TextBlock Text="{l:T ShapeHint}" Style="{StaticResource SecondaryText}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsTextLayer, Converter={StaticResource Visible}}">
                            <GroupBox Header="{l:T CardText}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{l:T TextContent}" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding TextContent, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="{x:Static core:TextLayer.MaxTextLength}" AutomationProperties.Name="{l:T TextContent}" />
                                    <TextBlock Text="{l:T TextFont}" Style="{StaticResource SecondaryText}" Margin="0,12,0,4" />
                                    <ComboBox ItemsSource="{Binding FontChoices}" SelectedItem="{Binding TextFontFamily, Mode=TwoWay}"
                                              AutomationProperties.Name="{l:T TextFont}" />
                                    <CheckBox Content="{l:T TextBold}" IsChecked="{Binding TextBold}" Margin="0,12,0,4" />
                                    <app:SettingSlider Label="{l:T Size}" Value="{Binding TextFontSize}" Margin="0,8,0,0"
                                                       Minimum="{x:Static core:TextLayer.MinFontSize}"
                                                       Maximum="{x:Static core:TextLayer.MaxFontSize}" />
                                    <app:SettingSlider Label="{l:T Rotation}" Value="{Binding TextRotation}"
                                                       Minimum="{x:Static core:CrosshairSettings.MinRotation}"
                                                       Maximum="{x:Static core:CrosshairSettings.MaxRotation}" />
                                    <TextBlock Text="{l:T TextHint}" Style="{StaticResource SecondaryText}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DesignTab, Converter={StaticResource EnumVisibility}, ConverterParameter=Color}">
                        <GroupBox Header="{l:T CardColorMode}">
                            <StackPanel>
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="ColorMode" Content="{l:T ModeStatic}"
                                                     IsChecked="{Binding ColorMode, Converter={StaticResource EnumMatch}, ConverterParameter=Static}" />
                                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="ColorMode" Content="{l:T ModeRainbow}"
                                                     IsChecked="{Binding ColorMode, Converter={StaticResource EnumMatch}, ConverterParameter=Rainbow}" />                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{l:T ModeStaticDescription}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0"
                                           Visibility="{Binding ColorMode, Converter={StaticResource EnumVisibility}, ConverterParameter=Static}" />
                                <StackPanel Visibility="{Binding ColorMode, Converter={StaticResource EnumVisibility}, ConverterParameter=Rainbow}">
                                    <TextBlock Text="{l:T ModeRainbowDescription}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,8" />
                                    <app:SettingSlider Label="{l:T Speed}" Value="{Binding RainbowSpeed}"
                                                       Minimum="{x:Static core:CrosshairSettings.MinRainbowSpeed}"
                                                       Maximum="{x:Static core:CrosshairSettings.MaxRainbowSpeed}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{l:T CardColor}" Margin="0">
                            <StackPanel>
                                <app:ColorField Label="{l:T ColorLabel}" Hex="{Binding ColorHex}" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}" Margin="120,8,0,8" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButton}" Background="{Binding}" Tag="{Binding}"
                                                    ToolTip="{Binding}" AutomationProperties.Name="{Binding}" Click="OnSwatch" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <app:SettingSlider Label="{l:T OpacityLabel}" Value="{Binding Opacity}"
                                                   Minimum="{x:Static core:CrosshairSettings.MinOpacity}"
                                                   Maximum="{x:Static core:CrosshairSettings.MaxOpacity}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DesignTab, Converter={StaticResource EnumVisibility}, ConverterParameter=Effects}">
                        <GroupBox>
                            <GroupBox.Header>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" Margin="0"
                                              IsChecked="{Binding ShowOutline}" AutomationProperties.Name="{l:T CardOutline}" />
                                    <TextBlock Text="{l:T CardOutline}" VerticalAlignment="Center" />
                                </DockPanel>
                            </GroupBox.Header>
                            <StackPanel IsEnabled="{Binding ShowOutline}">
                                <app:SettingSlider Label="{l:T Thickness}" Value="{Binding OutlineThickness}"
                                                   Minimum="{x:Static core:CrosshairSettings.MinOutlineThickness}"
                                                   Maximum="{x:Static core:CrosshairSettings.MaxOutlineThickness}" />
                                <app:ColorField Label="{l:T ColorLabel}" Hex="{Binding OutlineColorHex}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox>
                            <GroupBox.Header>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" Margin="0"
                                              IsChecked="{Binding ShowShadow}" AutomationProperties.Name="{l:T CardShadow}" />
                                    <TextBlock Text="{l:T CardShadow}" VerticalAlignment="Center" />
                                </DockPanel>
                            </GroupBox.Header>
                            <StackPanel IsEnabled="{Binding ShowShadow}">
                                <app:SettingSlider Label="{l:T Size}" Value="{Binding ShadowSize}"
                                                   Minimum="{x:Static core:CrosshairSettings.MinShadowSize}"
                                                   Maximum="{x:Static core:CrosshairSettings.MaxShadowSize}" />
                                <app:SettingSlider Label="{l:T OpacityLabel}" Value="{Binding ShadowOpacity}"
                                                   Minimum="{x:Static core:CrosshairSettings.MinShadowOpacity}"
                                                   Maximum="{x:Static core:CrosshairSettings.MaxShadowOpacity}" />
                                <app:ColorField Label="{l:T ColorLabel}" Hex="{Binding ShadowColorHex}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{l:T CardFireSpread}" Margin="0">
                            <StackPanel>
                                <app:SettingSlider Label="{l:T FireSpread}" Value="{Binding FireSpread}"
                                                   Minimum="{x:Static core:CrosshairDesign.MinFireSpread}"
                                                   Maximum="{x:Static core:CrosshairDesign.MaxFireSpread}" />
                                <app:SettingSlider Label="{l:T FireRecovery}" Value="{Binding FireRecovery}"
                                                   Minimum="{x:Static core:CrosshairDesign.MinFireRecovery}"
                                                   Maximum="{x:Static core:CrosshairDesign.MaxFireRecovery}" />
                                <TextBlock Text="{l:T FireSpreadHint}" Style="{StaticResource SecondaryText}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DesignTab, Converter={StaticResource EnumVisibility}, ConverterParameter=Layer}">
                        <GroupBox Header="{l:T CardLayerTransform}" Margin="0">
                            <StackPanel>
                                <app:SettingSlider Label="{l:T LayerOffsetX}" Value="{Binding LayerOffsetX}"
                                                   Minimum="{Binding MinLayerOffset}" Maximum="{Binding MaxLayerOffset}" />
                                <app:SettingSlider Label="{l:T LayerOffsetY}" Value="{Binding LayerOffsetY}"
                                                   Minimum="{Binding MinLayerOffset}" Maximum="{Binding MaxLayerOffset}" />
                                <app:SettingSlider Label="{l:T LayerScale}" Value="{Binding LayerScale}"
                                                   Minimum="{x:Static core:CrosshairLayer.MinScale}"
                                                   Maximum="{x:Static core:CrosshairLayer.MaxScale}" />
                                <app:SettingSlider Label="{l:T LayerBlur}" Value="{Binding LayerBlur}"
                                                   Minimum="{x:Static core:CrosshairLayer.MinBlur}"
                                                   Maximum="{x:Static core:CrosshairLayer.MaxBlur}" />
                                <TextBlock Text="{l:T LayerTransformHint}" Style="{StaticResource SecondaryText}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,16">
            <StackPanel Margin="0,8,0,0">
                <GroupBox Header="{l:T CardPreview}">
                    <StackPanel>
                        <Border Height="260" CornerRadius="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FF16191D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewScene}" Value="Light">
                                            <Setter Property="Background" Value="#FFE4E7EA" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewScene}" Value="Sky">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FF5E97D6" Offset="0" />
                                                        <GradientStop Color="#FFB5D5F2" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewScene}" Value="Forest">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF2E5429" Offset="0" />
                                                        <GradientStop Color="#FF4F8043" Offset="0.5" />
                                                        <GradientStop Color="#FF35602F" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Image Source="{Binding PreviewImage}"
                                       Width="{Binding PreviewZoomedSize}"
                                       Height="{Binding PreviewZoomedSize}"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                <Border Background="#CC1C1C1C" CornerRadius="6" Padding="14,10" MaxWidth="260"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsCrosshairEmpty, Converter={StaticResource Visible}}">
                                    <StackPanel>
                                        <TextBlock Text="{l:T PreviewEmptyTitle}" FontWeight="SemiBold" TextAlignment="Center" />
                                        <TextBlock Text="{l:T PreviewEmptyText}" Style="{StaticResource SecondaryText}" FontSize="12"
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewScaleText}" Style="{StaticResource SecondaryText}"
                                       FontSize="12" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="Scene" Padding="10,4" FontSize="12"
                                                 Content="{l:T SceneDark}"
                                                 IsChecked="{Binding PreviewScene, Converter={StaticResource EnumMatch}, ConverterParameter=Dark}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="Scene" Padding="10,4" FontSize="12"
                                                 Content="{l:T SceneLight}"
                                                 IsChecked="{Binding PreviewScene, Converter={StaticResource EnumMatch}, ConverterParameter=Light}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="Scene" Padding="10,4" FontSize="12"
                                                 Content="{l:T SceneSky}"
                                                 IsChecked="{Binding PreviewScene, Converter={StaticResource EnumMatch}, ConverterParameter=Sky}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="Scene" Padding="10,4" FontSize="12"
                                                 Content="{l:T SceneForest}"
                                                 IsChecked="{Binding PreviewScene, Converter={StaticResource EnumMatch}, ConverterParameter=Forest}" />
                                </StackPanel>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding PreviewModeHint}" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="{Binding PreviewModeHint, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox>
                    <GroupBox.Header>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE710;" Click="OnAddLayer" IsEnabled="{Binding CanAddLayer}"
                                        ToolTip="{l:T LayerAdd}" AutomationProperties.Name="{l:T LayerAdd}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Click="OnLayerForward" IsEnabled="{Binding CanMoveLayerForward}"
                                        ToolTip="{l:T LayerForward}" AutomationProperties.Name="{l:T LayerForward}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74B;" Click="OnLayerBackward" IsEnabled="{Binding CanMoveLayerBackward}"
                                        ToolTip="{l:T LayerBackward}" AutomationProperties.Name="{l:T LayerBackward}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="OnRemoveLayer" IsEnabled="{Binding CanRemoveLayer}"
                                        ToolTip="{l:T LayerRemove}" AutomationProperties.Name="{l:T LayerRemove}" />
                            </StackPanel>
                            <TextBlock Text="{l:T CardLayers}" VerticalAlignment="Center" />
                        </DockPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayerItem, Mode=TwoWay}" MaxHeight="220"
                                 AutomationProperties.Name="{l:T CardLayers}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemBase}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource EyeToggle}" IsChecked="{Binding Visible}"
                                                  ToolTip="{l:T LayerVisible}" AutomationProperties.Name="{l:T LayerVisible}" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,10,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryText}" FontSize="11" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{l:T LayersHint}" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{l:T CardActivePreset}">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="{l:T CardActivePreset}" />
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="{l:T CopyCode}" Style="{StaticResource AccentButton}"
                                    Margin="8,0,0,0" Click="OnCopyShareCode" />
                            <TextBox Text="{Binding ShareCodeText, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.Name="{l:T ShareCode}" />
                        </DockPanel>
                        <TextBlock Text="{Binding ShareStatus}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding ShareStatus, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
