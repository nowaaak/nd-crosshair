<UserControl x:Class="NdCrosshair.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NdCrosshair.App.Localization">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:T NavAbout}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T AboutSubtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,24">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                <Border Style="{StaticResource Card}" Padding="24,20">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="72" Height="72" CornerRadius="16" Background="Black"
                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <Path Data="{StaticResource LogoGeometry}" Fill="White" Stretch="Uniform" Margin="14" />
                        </Border>
                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ND Crosshair" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,6" />
                            <TextBlock Text="{l:T AboutDescription}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="{l:T SectionSafety}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T SafetyNoAccess}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{l:T SafetyNoHooks}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{l:T SafetyAdaptive}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{l:T SafetyRules}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{l:T SectionTips}" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T FortniteHintTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{l:T FortniteHintText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
