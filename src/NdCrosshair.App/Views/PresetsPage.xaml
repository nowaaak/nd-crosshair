<UserControl x:Class="NdCrosshair.App.Views.PresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:NdCrosshair.Core;assembly=NdCrosshair.Core"
             xmlns:l="clr-namespace:NdCrosshair.App.Localization">
    <UserControl.Resources>
        <Style x:Key="PresetTile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="156">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="{StaticResource HoverDuration}" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Chrome" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" />
                            <Border x:Name="Hover" Background="{StaticResource HoverOverlayBrush}" CornerRadius="8" Opacity="0" />
                            <StackPanel Margin="8">
                                <Border Height="104" CornerRadius="6" Background="#FF2E343B">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly" Margin="6"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="4,8,4,2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border x:Name="Badge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                                    Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="{l:T PresetActive}" Foreground="{StaticResource OnAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{l:T NavPresets}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{l:T PresetsSubtitle}" Style="{StaticResource PageSubtitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Style="{StaticResource AccentButton}" Click="OnAdd" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{l:T PresetNew}" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnDuplicate">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{l:T PresetDuplicate}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource PresetTile}" AutomationProperties.Name="{l:T NavPresets}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,24">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DockPanel>

        <StackPanel Grid.Column="2" Margin="0,8,0,0">
            <GroupBox Header="{l:T CardPresetDetails}">
                <StackPanel>
                    <TextBlock Text="{l:T PresetName}" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SelectedPreset.Name, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="{x:Static core:Preset.MaxNameLength}" AutomationProperties.Name="{l:T PresetName}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{l:T EditDesign}" Click="OnEdit" Margin="0,0,8,0" />
                        <Button Content="{l:T Delete}" Style="{StaticResource DangerButton}" Click="OnDelete"
                                IsEnabled="{Binding CanDeletePreset}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{l:T CardShare}">
                <StackPanel>
                    <TextBlock Text="{l:T ShareCode}" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:T CopyCode}" Style="{StaticResource AccentButton}"
                                Margin="8,0,0,0" Click="OnCopy" />
                        <TextBox Text="{Binding ShareCodeText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.Name="{l:T ShareCode}" />
                    </DockPanel>
                    <TextBlock Text="{l:T ImportCode}" Style="{StaticResource SecondaryText}" Margin="0,14,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:T Import}" Margin="8,0,0,0" Click="OnImport" />
                        <TextBox Text="{Binding ImportCode, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.Name="{l:T ImportCode}" />
                    </DockPanel>
                    <TextBlock Text="{l:T ImportCodeHint}" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ShareStatus}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap" Visibility="{Binding ShareStatus, Converter={StaticResource Visible}}" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
