<UserControl x:Class="NdCrosshair.App.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NdCrosshair.App.Localization">
    <StackPanel Width="248">
        <Border CornerRadius="6" ClipToBounds="True" Height="156">
            <Grid x:Name="SvArea" Background="Transparent" Focusable="True" Cursor="Cross"
                  FocusVisualStyle="{StaticResource FocusVisual}"
                  AutomationProperties.Name="{l:T PickerSaturation}"
                  MouseLeftButtonDown="OnSvMouseDown" MouseMove="OnSvMouseMove" MouseLeftButtonUp="OnAreaMouseUp"
                  KeyDown="OnSvKeyDown">
                <Rectangle x:Name="HueLayer" RadiusX="6" RadiusY="6" />
                <Rectangle RadiusX="6" RadiusY="6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle RadiusX="6" RadiusY="6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <Grid x:Name="HueArea" Height="16" Margin="0,12,0,0" Background="Transparent" Focusable="True" Cursor="Hand"
              FocusVisualStyle="{StaticResource FocusVisual}"
              AutomationProperties.Name="{l:T PickerHue}"
              MouseLeftButtonDown="OnHueMouseDown" MouseMove="OnHueMouseMove" MouseLeftButtonUp="OnAreaMouseUp"
              KeyDown="OnHueKeyDown">
            <Border CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFF0000" Offset="0" />
                        <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                        <GradientStop Color="#FF00FF00" Offset="0.3333" />
                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                        <GradientStop Color="#FF0000FF" Offset="0.6667" />
                        <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                        <GradientStop Color="#FFFF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="HueThumb" Width="16" Height="16" Stroke="White" StrokeThickness="3">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <DockPanel Margin="0,12,0,0">
            <Border x:Name="Swatch" Width="32" Height="32" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{StaticResource ControlBorderBrush}" />
            <TextBox x:Name="HexBox" Margin="8,0,0,0" TextAlignment="Center" FontFamily="Cascadia Mono, Consolas"
                     AutomationProperties.Name="{l:T PickerHex}"
                     KeyDown="OnHexKeyDown" LostKeyboardFocus="OnHexLostFocus" />
        </DockPanel>
    </StackPanel>
</UserControl>
