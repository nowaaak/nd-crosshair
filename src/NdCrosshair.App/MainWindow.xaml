<Window x:Class="NdCrosshair.App.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NdCrosshair.App.Views"
        xmlns:l="clr-namespace:NdCrosshair.App.Localization"
        Title="ND Crosshair"
        Icon="Assets/app.ico"
        Width="1240"
        Height="820"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,0,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,14,0,22">
                    <Border Width="34" Height="34" CornerRadius="8" Background="Black"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <Path Data="{StaticResource LogoGeometry}" Fill="White" Stretch="Uniform" Margin="7" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ND Crosshair" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource SecondaryText}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0" Padding="14,12">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" Margin="0"
                                      IsChecked="{Binding OverlayVisible}" AutomationProperties.Name="{l:T SidebarOverlay}" />
                            <TextBlock Text="{l:T SidebarOverlay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{l:T SidebarPreset}" />
                            <Run Text="{Binding SelectedPreset.Name, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0">
                            <Run Text="{l:T SidebarHotkey}" />
                            <Run Text="{Binding ToggleHotkeyText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                        </TextBlock>
                        <WrapPanel Margin="0,8,0,0">
                            <Border CornerRadius="4" Background="{StaticResource SelectedBrush}" Padding="6,2" Margin="0,0,4,0"
                                    Visibility="{Binding ShowOnlyOverGame, Converter={StaticResource Visible}}">
                                <TextBlock Text="{l:T BadgeGameOnly}" FontSize="11" />
                            </Border>
                            <Border CornerRadius="4" Background="{StaticResource SelectedBrush}" Padding="6,2"
                                    Visibility="{Binding StreamerMode, Converter={StaticResource Visible}}">
                                <TextBlock Text="{l:T BadgeStreamer}" FontSize="11" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE790;" Content="{l:T NavCrosshair}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Crosshair}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="{l:T NavPresets}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Presets}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7F4;" Content="{l:T NavOverlay}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Overlay}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE765;" Content="{l:T NavHotkeys}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Hotkeys}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="{l:T NavSystem}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=System}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE946;" Content="{l:T NavAbout}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=About}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize"
                        AutomationProperties.Name="{l:T WindowMinimize}" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize"
                        AutomationProperties.Name="{l:T WindowMaximize}" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose"
                        AutomationProperties.Name="{l:T Close}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="36,0,36,0">
                <views:CrosshairPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=Crosshair}" />
                <views:PresetsPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=Presets}" />
                <views:OverlayPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=Overlay}" />
                <views:HotkeysPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=Hotkeys}" />
                <views:SystemPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=System}" />
                <views:AboutPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=About}" />
            </Grid>
        </Grid>

        <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Background="{StaticResource DialogScrimBrush}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="460" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PopupBrush}" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DialogMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,24" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogCancel" Content="{l:T Cancel}" MinWidth="110" Margin="0,0,8,0" Click="OnDialogCancel" />
                        <Button x:Name="DialogConfirm" MinWidth="110" Click="OnDialogConfirm" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
