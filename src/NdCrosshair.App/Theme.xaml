    <Style TargetType="controls:SettingCard">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingCard">
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <DockPanel MinHeight="36">
                                <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Glyph}" FontFamily="{StaticResource IconFont}"
                                           FontSize="18" Width="22" Margin="2,0,16,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding Glyph, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}" />
                                <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                                    <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource SecondaryText}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </DockPanel>
                            <ContentPresenter Content="{TemplateBinding Body}" Margin="0,12,0,0"
                                              Visibility="{Binding Body, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

