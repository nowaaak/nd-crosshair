                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{StaticResource HoverOverlayBrush}" CornerRadius="4" Opacity="0" />
